# 应用配置
APP_NAME=高校自动排课系统
APP_VERSION=0.1.0
DEBUG=true

# 数据库配置
DATABASE_URL=sqlite:///./schedule.db

# JWT 配置
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 排课默认配置
DEFAULT_SCHEDULE_TIME_LIMIT=120
DEFAULT_DAYS_PER_WEEK=5
DEFAULT_SECTIONS_PER_DAY=10
